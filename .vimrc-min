set showtabline=2
set laststatus=0

function! MyTabLine()
    let s = ''
    for i in range(1, tabpagenr('$'))
        let buflist = tabpagebuflist(i)
        let name = fnamemodify(bufname(buflist[tabpagewinnr(i) - 1]), ':t')
        let s .= (i == tabpagenr() ? '%#TabLineSel#' : '%#TabLine#')
        let s .= ' ' . (empty(name) ? '[No Name]' : name) . ' '
    endfor
    let s .= '%#TabLineFill#%='
    let s .= ' [TYPE: %Y] [LINE: %l/%L : %c] [%p%%] %{Modified_Get()} '
    return s
endfunction

set tabline=%!MyTabLine()


